# Optional in the browser. Leave empty to derive ws:// or wss:// from the current origin.
VITE_PRIMEVERSE_WS_URL=

# Required on Vercel/production. Provision a Redis integration that exposes a TCP REDIS_URL.
REDIS_URL=

# Optional override. With Vercel System Environment Variables exposed, the default isolates
# project, environment and preview branch. Otherwise set a distinct value per environment.
PRIMEVERSE_REDIS_PREFIX=

# Comma-separated origins accepted by the WebSocket upgrade. Defaults to the deployment origin.
PRIMEVERSE_ALLOWED_ORIGINS=

# Local multiplayer server port. The Vite proxy reads this same value.
PORT=8787

# Only for scripts/generate-origin-voices.ts (npm run voices:origins). Never shipped to the client;
# the generated audio lands in public/games/primebound/. Gemini key is free (aistudio.google.com/apikey)
# and gives real acted intonation; rerun the script daily until the free quota covers every line.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
