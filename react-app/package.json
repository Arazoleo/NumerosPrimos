{
  "name": "numeros-primos-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:all",
    "dev:web": "vite",
    "dev:multiplayer": "tsx watch --env-file-if-exists=.env.local server/primeverse-online/dev.ts",
    "dev:all": "concurrently --kill-others --names WEB,ONLINE --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:multiplayer\"",
    "build": "vite build",
    "build:server": "tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run build:server",
    "test": "vitest run",
    "voices:origins": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-origin-voices.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "express": "^5.2.1",
    "framer-motion": "^11.11.17",
    "ioredis": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "three": "^0.170.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
